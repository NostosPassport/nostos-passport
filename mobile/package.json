{
  "name": "nostos-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/courier-prime": "^0.4.1",
    "@expo-google-fonts/source-serif-4": "^0.4.2",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.103.2",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-gl": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-media-library": "~58.0.13",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "piexifjs": "^1.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "three": "0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/three": "0.186.0",
    "babel-preset-expo": "~58.0.23",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings 0",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test -- --silent",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "test:live": "NOSTOS_LIVE_API=${NOSTOS_LIVE_API:-http://localhost:3000} jest -c jest.live.config.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/ios",
    "resolver": "react-native-reanimated/jest/resolver",
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/api/__tests__/live.test.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|three))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
