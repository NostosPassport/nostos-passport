{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://preview-api.nostospassport.com"
      }
    },
    "preview": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://preview-api.nostospassport.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.nostospassport.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6820582476"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6820582476"
      }
    }
  }
}
