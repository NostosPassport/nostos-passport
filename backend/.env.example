# Local development only. These credentials are for the Docker Postgres in docker-compose.yml.
DATABASE_URL="postgresql://nostos:nostos@localhost:5438/nostos_codex?schema=public"
# Direct (unpooled) URL for migrations. Locally the same as DATABASE_URL; on Neon the non-pooler host.
DIRECT_URL="postgresql://nostos:nostos@localhost:5438/nostos_codex?schema=public"
TEST_DATABASE_URL="postgresql://nostos:nostos@localhost:5438/nostos_codex_test?schema=public"
# Shared password for every seeded account (dev only).
DEV_SEED_PASSWORD="lastcall-dev"
# Where uploaded photos are written (relative to project root).
UPLOAD_DIR="uploads"
# App environment: development | preview | production. The demo seed refuses to run in production.
APP_ENV="development"
# Photo storage: "local" (development) or "r2" (preview/production, see DEPLOY.md).
STORAGE_DRIVER="local"
# HMAC secret for local signed photo URLs (>= 32 chars). Required when NODE_ENV=production.
UPLOAD_URL_SECRET="dev-only-upload-url-secret-change-me-0000"
# Bearer secret Vercel Cron sends to /api/cron/reputation.
CRON_SECRET="dev-cron-secret"
SOCIAL_ENABLED="0"

# Codex backend development port.
PORT=3001
