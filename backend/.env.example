# Local development only. These credentials are for the Docker Postgres in docker-compose.yml.
DATABASE_URL="postgresql://nostos:nostos@localhost:5438/nostos_codex?schema=public"
# Direct (unpooled) URL for migrations. Locally the same as DATABASE_URL; on Neon use the non-pooler connection.
DIRECT_URL="postgresql://nostos:nostos@localhost:5438/nostos_codex?schema=public"
TEST_DATABASE_URL="postgresql://nostos:nostos@localhost:5438/nostos_codex_test?schema=public"

# Shared password for seeded accounts only (development helper; production auth is passwordless).
DEV_SEED_PASSWORD="lastcall-dev"

# App environment: development | preview | production. The demo seed refuses to run in production.
APP_ENV="development"
SOCIAL_ENABLED="0"

# Photo storage: local for development; r2 for preview/production.
STORAGE_DRIVER="local"
# Local storage only.
UPLOAD_DIR="uploads"
# HMAC secret for local signed photo URLs. R2 uses S3 presigned URLs instead.
UPLOAD_URL_SECRET="dev-only-upload-url-secret-change-me-0000"
# Required when STORAGE_DRIVER=r2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Bearer secret Vercel Cron sends to /api/cron/maintenance.
CRON_SECRET="dev-cron-secret"

# Passwordless authentication email. In local development, leaving RESEND_API_KEY blank logs OTPs to the backend console.
# Never commit the real key. Put it in backend/.env locally and in the production host's secret environment variables.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Nostos <login@auth.nostospassport.com>"
# Used by the shared email-otp template footer. Production must use a complete business mailing address.
AUTH_COMPANY_ADDRESS="New York, NY"
# Optional override. Every OTP flow defaults to the published Resend template id `email-otp`.
# Template variables: verification_code, first_name, expiry_minutes, company_address.
RESEND_VERIFY_EMAIL_TEMPLATE_ID="email-otp"
# HMAC secret for one-time email codes. Set a random 32-byte+ value in production, e.g. `openssl rand -hex 32`.
AUTH_CODE_SECRET=""

# Backend development port.
PORT=3001
