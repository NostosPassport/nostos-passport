// Nostos data model.
// Conventions: snake_case tables/columns, all timestamps stored in UTC (timestamptz).
// A stamp is a row in `photo` (the table name is kept to avoid migration churn; API and UI say "stamp").
// A place is a row in `venue` (same reason).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SessionClient {
  WEB
  IOS
}

enum EmailChallengePurpose {
  SIGN_UP
  SIGN_IN
  CHANGE_EMAIL
  DELETE_ACCOUNT
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  handle          String    @unique
  displayName     String    @map("display_name")
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  ageVerifiedAt   DateTime? @map("age_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion    String?   @map("terms_version")
  geofenceExempt  Boolean   @default(false) @map("geofence_exempt")
  bio             String    @default("")
  avatarKey       String?   @map("avatar_key")

  sessions    Session[]
  photos      Photo[]
  rateEvents  RateEvent[]
  pinned      PinnedStamp[]
  collections Collection[]

  @@map("app_user")
}

model Session {
  id        String        @id
  userId    String        @map("user_id")
  client    SessionClient @default(WEB)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model EmailChallenge {
  id         String                @id
  email      String
  codeHash   String                @map("code_hash")
  purpose    EmailChallengePurpose
  ip         String
  attempts   Int                   @default(0)
  expiresAt  DateTime              @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?             @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, purpose, createdAt])
  @@index([ip, createdAt])
  @@index([expiresAt])
  @@map("email_challenge")
}

model Venue {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  address              String
  area                 String?
  city                 String?
  region               String?
  country              String?
  countryCode          String?  @map("country_code")
  timeZone             String   @default("UTC") @map("time_zone")
  lat                  Float
  lng                  Float
  geofenceMeters       Int      @default(100) @map("geofence_meters")
  osmId                String?  @unique @map("osm_id")
  googlePlaceId        String?  @unique @map("google_place_id")
  googlePrimaryType    String?  @map("google_primary_type")
  googleTypes          String[] @default([]) @map("google_types")
  cuisines             String[] @default([])
  category             String?
  googleBusinessStatus String?  @map("google_business_status")
  googlePriceLevel     String?  @map("google_price_level")
  googlePriceCheckedAt DateTime? @map("google_price_checked_at") @db.Timestamptz(3)
  michelinStars        Int?     @map("michelin_stars") @db.SmallInt
  michelinCheckedAt    DateTime? @map("michelin_checked_at") @db.Timestamptz(3)
  googleSyncedAt       DateTime? @map("google_synced_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  photos Photo[]

  @@index([countryCode, city])
  @@map("venue")
}

model Photo {
  creationTransaction String    @default(dbgenerated("txid_current()::text")) @map("creation_transaction")
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  venueId             String    @map("venue_id")
  storageKey          String?   @unique @map("storage_key")
  mimeType            String?   @map("mime_type")
  caption             String
  songTitle           String?   @map("song_title")
  songArtist          String?   @map("song_artist")
  songArtUrl          String?   @map("song_art_url")
  songSourceId        String?   @map("song_source_id")
  lat                 Float?
  lng                 Float?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  visitedAt           DateTime  @default(now()) @map("visited_at") @db.Timestamptz(3)
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(3)
  rating              Int?      @db.SmallInt
  editedAt            DateTime? @map("edited_at") @db.Timestamptz(3)
  removedAt           DateTime? @map("removed_at") @db.Timestamptz(3)
  countable           Boolean   @default(true)
  user                User      @relation(fields: [userId], references: [id])
  venue               Venue     @relation(fields: [venueId], references: [id])
  photos              StampPhoto[]
  pins                PinnedStamp[]
  collections         CollectionStamp[]

  @@index([venueId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt, id])
  @@index([venueId, visitedAt])
  @@index([userId, visitedAt])
  @@map("photo")
}

model Collection {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  color     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stamps    CollectionStamp[]
  share     CollectionShare?

  @@index([userId, createdAt])
  @@map("collection")
}

model CollectionShare {
  id           String     @id @default(cuid())
  collectionId String     @unique @map("collection_id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@map("collection_share")
}

model CollectionStamp {
  collectionId String     @map("collection_id")
  stampId      String     @map("stamp_id")
  position     Int
  addedAt      DateTime   @default(now()) @map("added_at") @db.Timestamptz(3)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  stamp        Photo      @relation(fields: [stampId], references: [id], onDelete: Cascade)

  @@id([collectionId, stampId])
  @@index([collectionId, position])
  @@index([stampId])
  @@map("collection_stamp")
}

model StampPhoto {
  id         String    @id @default(cuid())
  stampId    String    @map("stamp_id")
  storageKey String    @unique @map("storage_key")
  mimeType   String    @map("mime_type")
  position   Int       @db.SmallInt
  x          Float?
  y          Float?
  rotation   Float?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(3)
  stamp      Photo     @relation(fields: [stampId], references: [id])

  @@index([stampId, position])
  @@map("stamp_photo")
}

model PinnedStamp {
  userId   String   @map("user_id")
  stampId  String   @map("stamp_id")
  position Int      @db.SmallInt
  pinnedAt DateTime @default(now()) @map("pinned_at") @db.Timestamptz(3)
  user     User     @relation(fields: [userId], references: [id])
  stamp    Photo    @relation(fields: [stampId], references: [id])

  @@id([userId, stampId])
  @@unique([userId, position])
  @@map("pinned_stamp")
}

model RateEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  kind      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, kind, createdAt])
  @@index([createdAt])
  @@map("rate_event")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, ip, createdAt])
  @@index([createdAt])
  @@map("login_attempt")
}
