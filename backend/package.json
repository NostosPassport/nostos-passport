{
  "name": "nostos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-env.mjs && prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:reset": "tsx prisma/check-seed-allowed.ts && prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "job:reputation": "tsx scripts/recompute-reputation.ts",
    "bundle": "node scripts/make-review-bundle.mjs",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "test:pooled": "node scripts/test-pooled.mjs",
    "venues:import": "tsx scripts/import-osm-venues.ts",
    "user:role": "tsx scripts/set-role.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@aws-sdk/s3-request-presigner": "3.1139.0",
    "@prisma/client": "6.19.3",
    "leaflet": "1.9.4",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "pngjs": "7.0.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  }
}
